 * SPDX-License-Identifier: MIT
 *
 * Layout ported from the "DH747 W-CORNE" QMK/Vial config (current.vil):
 *   0 BASE    - QWERTY + Corne mod-taps
 *   1 NAV     - arrows / page / GUI-ALT-CTRL-SHIFT / undo-cut-copy-paste   (MO, left thumb)
 *   2 SYMBOLS - shifted number row + brackets / operators                  (MO, right thumb)
 *   3 NUMPAD  - F1-F12 + numpad                                            (MO, left thumb)
 *   4 MEDIA   - volume / brightness / transport + macros M0-M4             (hold Esc)
 *   5 GAMING  - plain QWERTY, no mod-taps                                  (toggle)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE    0
#define NAV     1
#define SYMBOLS 2
#define NUMPAD  3
#define MEDIA   4
#define GAMING  5

/ {
    behaviors {
        // Corne TD(0): tap = "[", double-tap = "]"
        td_brkt: tap_dance_brackets {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp LBKT>, <&kp RBKT>;
        };
    };

    macros {
        // Corne M0: type "Jvrfhf" then Enter
        m0: m0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings = <&kp LS(J) &kp V &kp R &kp F &kp H &kp F &kp RET>;
        };
        // Corne M1-M4: hold Space, tap letter, release Space
        m1: m1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp SPACE>, <&macro_tap &kp U>, <&macro_release &kp SPACE>;
        };
        m2: m2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp SPACE>, <&macro_tap &kp P>, <&macro_release &kp SPACE>;
        };
        m3: m3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp SPACE>, <&macro_tap &kp R>, <&macro_release &kp SPACE>;
        };
        m4: m4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp SPACE>, <&macro_tap &kp Q>, <&macro_release &kp SPACE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
// -----------------------------------------------------------------------------------------------
// |   `   |  1  |  2  |  3  |  4  |  5  |                 |  6  |  7  |  8  |  9  |  0  | BKSP |
// | ESC/M |  Q  |  W  |  E  |  R  |  T  |                 |  Y  |  U  |  I  |  O  |  P  | GUI  |
// | TAB/^ |  A  |  S  |  D  |  F  |  G  |                 |  H  |  J  |  K  |  L  |  ;  | ALT  |
// | BSL/S |  Z  |  X  |  C  |  V  |  B  | MUTE  |  [/]    |  N  |  M  |  ,  |  .  |  /  | SHFT |
//         |CTRL | ALT | NUM | NAV |SPC/GUI| SPACE | BKSP  | SYM |  '  | RET/SHFT |
            bindings = <
&kp GRAVE      &kp N1 &kp N2    &kp N3    &kp N4     &kp N5                                    &kp N6      &kp N7   &kp N8    &kp N9   &kp N0   &kp BSPC
&lt MEDIA ESC  &kp Q  &kp W     &kp E     &kp R      &kp T                                     &kp Y       &kp U    &kp I     &kp O    &kp P    &td_brkt
&mt LCTRL TAB  &kp A  &kp S     &kp D     &kp F      &kp G                                     &kp H       &kp J    &kp K     &kp L    &kp SEMI &kp RALT
&mt LSHFT BSLH &kp Z  &kp X     &kp C     &kp V      &kp B       &kp C_MUTE   &none            &kp N       &kp M    &kp COMMA &kp DOT  &kp FSLH &mt RSHFT RET
                      &kp LCTRL &kp LALT  &mo NUMPAD &mo NAV     &mt LGUI SPACE  &kp SPACE  &kp BSPC  &mo SYMBOLS  &kp SQT  &mt RSHFT RET
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        nav_layer {
            display-name = "NAV";
// -----------------------------------------------------------------------------------------------
// |     |     |     |     |     |     |                 | PGUP| HOME|  UP | END | DEL |     |
// |     | GUI | ALT |CTRL | SHFT|     |                 | PGDN| LEFT| DOWN| RGHT| BKSP|     |
// |     | UNDO| CUT | COPY| PSTE|     |                 |     |     |     |     |     |     |
// |     |     |     |     |     |     |     |     |     |     |     |     |     |     |     |
            bindings = <
&trans &trans     &trans    &trans     &trans      &trans                              &kp PG_UP &kp HOME  &kp UP   &kp END   &kp DEL  &trans
&trans &trans     &trans    &trans     &trans      &trans                              &kp PG_DN &kp LEFT  &kp DOWN &kp RIGHT &kp BSPC &trans
&trans &kp LGUI   &kp LALT  &kp LCTRL  &kp LSHFT   &trans                              &trans    &trans    &trans   &trans    &trans   &trans
&trans &kp K_UNDO &kp K_CUT &kp K_COPY &kp K_PASTE &trans     &trans   &trans          &trans    &trans    &trans   &trans    &trans   &trans
                  &trans    &trans     &trans      &trans     &trans   &trans          &trans    &trans    &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        symbols_layer {
            display-name = "SYM";
// -----------------------------------------------------------------------------------------------
// |     |  !  |  @  |  #  |  $  |  %  |                 |  ^  |  &  |  *  |  (  |  )  |     |
// |     |  `  |  \  |  {  |  }  |  |  |                 |  +  |  -  |  =  |  [  |  ]  |     |
// |     |  ~  |     |  <  |  >  |     |                 |  _  |  :  |  ;  |     |  /  |     |
// |     |     |     |     |     |     |     |     |     |     |     |     |     |     |     |
            bindings = <
&trans &kp EXCL  &kp AT   &kp HASH &kp DLLR &kp PRCNT                            &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &trans
&trans &kp GRAVE &kp BSLH &kp LBRC &kp RBRC &kp PIPE                             &kp PLUS  &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &trans
&trans &kp TILDE &trans   &kp LT   &kp GT   &trans                              &kp UNDER &kp COLON &kp SEMI  &trans   &kp FSLH &trans
&trans &trans    &trans   &trans   &trans   &trans     &trans   &trans          &trans    &trans    &trans    &trans   &trans   &trans
                 &trans   &trans   &trans   &trans     &trans   &trans          &trans    &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        numpad_layer {
            display-name = "NUM";
// -----------------------------------------------------------------------------------------------
// |     | F1  | F2  | F3  | F4  | F5  |                 |  /  |  7  |  8  |  9  |  -  |     |
// |     | F6  | F7  | F8  | F9  | F10 |                 |  *  |  4  |  5  |  6  |  +  |     |
// |     | F11 | F12 |     |     |     |                 |  0  |  1  |  2  |  3  |  =  |     |
// |     |     |     |     |     |     |     |     |  .  |     | GUI |     |     |     |     |
            bindings = <
&trans &kp F1  &kp F2  &kp F3 &kp F4 &kp F5                                 &kp FSLH  &kp N7   &kp N8  &kp N9 &kp MINUS &trans
&trans &kp F6  &kp F7  &kp F8 &kp F9 &kp F10                                &kp ASTRK &kp N4   &kp N5  &kp N6 &kp PLUS  &trans
&trans &kp F11 &kp F12 &trans &trans &trans                                &kp N0    &kp N1   &kp N2  &kp N3 &kp EQUAL &trans
&trans &trans  &trans  &trans &trans &trans     &trans   &trans            &trans    &trans   &trans  &trans &trans    &trans
               &trans  &trans &trans &trans     &trans   &kp DOT           &trans    &kp LGUI &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        media_layer {
            display-name = "MEDIA";
// -----------------------------------------------------------------------------------------------
// |     | VOL-| VOL+| MUTE|     | GAME|                 | M1  | M2  | M3  | M4  | M0  |     |
// |     | BRI-| BRI+|     |     |     |                 |     | PREV| PLAY| NEXT|     |     |
// |     |     |     |     |     |     |                 |     |     |     |     |     |     |
// |     |     |     |     |     |     |     |HYPER-L|   |     |     |     |     |     |     |
            bindings = <
&trans &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &trans &tog GAMING                          &m1    &m2        &m3      &m4        &m0    &trans
&trans &kp C_BRI_DN &kp C_BRI_UP &trans     &trans &trans                               &trans &kp C_PREV &kp C_PP &kp C_NEXT &trans &trans
&none  &none        &none        &none      &trans &none                                &trans &trans     &trans   &trans     &trans &trans
&none  &none        &none        &none      &trans &none       &trans  &kp LC(LA(LG(L)))  &trans &trans   &trans   &trans     &trans &trans
                    &none        &none      &trans &trans      &trans  &trans             &trans &trans   &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN &inc_dec_kp C_NEXT C_PREV>;
        };

        gaming_layer {
            display-name = "GAME";
// -----------------------------------------------------------------------------------------------
// |  `  |  1  |  2  |  3  |  4  |  5  |                 |  6  |  7  |  8  |  9  |  0  | BKSP |
// | ESC |  Q  |  W  |  E  |  R  |  T  |                 |  Y  |  U  |  I  |  O  |  P  | GUI  |
// | TAB |  A  |  S  |  D  |  F  |  G  |                 |  H  |  J  |  K  |  L  |  ;  | ALT  |
// | SHFT|  Z  |  X  |  C  |  V  |  B  | MUTE  | BKSP    |  N  |  M  |  ,  |  .  |  /  | SHFT |
//       |CTRL | ALT |CTRL | GUI |ENTER  | SPACE | GAME  |RALT |  '  | SHFT |
            bindings = <
&trans    &kp N1 &kp N2    &kp N3   &kp N4    &kp N5                                    &kp N6 &kp N7 &kp N8    &kp N9  &kp N0   &kp BSPC
&kp ESC   &kp Q  &kp W     &kp E    &kp R     &kp T                                     &kp Y  &kp U  &kp I     &kp O   &kp P    &kp LGUI
&kp TAB   &kp A  &kp S     &kp D    &kp F     &kp G                                     &kp H  &kp J  &kp K     &kp L   &kp SEMI &kp RALT
&kp LSHFT &kp Z  &kp X     &kp C    &kp V     &kp B       &kp C_MUTE   &kp BSPC         &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                 &kp LCTRL &kp LALT &kp LCTRL &kp LGUI    &kp RET      &kp SPACE  &tog GAMING  &kp RALT &kp SQT &kp RSHFT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

    };
};
